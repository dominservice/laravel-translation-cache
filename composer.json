{
    "name": "dominservice/laravel-translation-cache",
    "description": "Compile Laravel translations and database overrides into a lazy, file-based cache.",
    "keywords": [
        "cache",
        "laravel",
        "localization",
        "translation"
    ],
    "homepage": "https://github.com/dominservice/laravel-translation-cache",
    "license": "MIT",
    "authors": [
        {
            "name": "DSO-IT Mateusz Domin",
            "email": "biuro@dso.biz.pl"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.32"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Dominservice\\LaravelTranslationCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dominservice\\LaravelTranslationCache\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dominservice\\LaravelTranslationCache\\TranslationCacheServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "format": "pint --format agent",
        "test": "phpunit --colors=always"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
